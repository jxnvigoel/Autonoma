# Autonoma environment configuration (optional).
# The agents run on local Ollama models, so the app works without this file.

# Address of the Ollama server (default shown).
# OLLAMA_HOST=http://localhost:11434

# Local model to use when none of the models in config/model_router.json is installed.
# OLLAMA_MODEL=qwen2.5-coder:7b

# Only needed if you turn the cloud on ("cloud_enabled": true in config/model_router.json).
GROQ_API_KEY=
